# credentials.list — key material and home credential stores (shared contract §1.2).
#
# Columns: class os sb glob. The glob is the rest of the line and may contain spaces.
#   class: key_material | host_token | vault | browser_store | wallet_ext
#   os:    any | macos | linux | windows
#   sb:    lowest kit tier whose SANDBOX denyRead carries the entry (relaxed | medium | high |
#          never): what subprocesses may read. Hook consumers ignore sb and deny agent reads
#          of every entry at every tier.
# A line starting with ! is an exception (readable). Globs: * one segment, ** any segments,
# ? one char, trailing / = the directory and everything below, ~ = passwd home and $HOME,
# ${CLAUDE_CONFIG_DIR:-~/.claude} the only variable; no braces or char classes (contract §1.3).
# Records are sorted (LC_ALL=C) and unique within each [section]; sections record provenance.
#
# Seeded once (contract 1.0.0) from solanabr/solana-ai-kit .claude/bin/firewall.sh at kit
# commit 42755ab (the file last changed in 0ffd72b; RULE_SET_VERSION 7). From now on this file
# is the source: the kit vendors it (scripts/vendor-shared.sh) and deletes its own arrays.
# Contract fixes applied once: ~/.config/solana/id.json sb=never (sandboxed solana/anchor must
# sign; agent reads stay denied), ~/.kube/config classed key_material (spec §4).

# Kit SB_CREDENTIALS (13).
[kit:SB_CREDENTIALS]
key_material any never ~/.config/solana/id.json
key_material any relaxed ~/.aws/
key_material any relaxed ~/.claude/.credentials.json
key_material any relaxed ~/.gnupg/
key_material any relaxed ~/.ssh/
vault any relaxed ~/.config/1Password/
vault any relaxed ~/.config/Bitwarden/
vault any relaxed ~/.config/keepassxc/
vault any relaxed ~/.password-store/
vault linux relaxed ~/.gnome2/keyrings/
vault linux relaxed ~/.local/share/keyrings/
vault macos relaxed /Library/Keychains/
vault macos relaxed ~/Library/Keychains/

# Kit SB_HOST_CREDENTIALS (10), sandbox-denied from Medium.
[kit:SB_HOST_CREDENTIALS]
host_token any medium ~/.cargo/credentials
host_token any medium ~/.cargo/credentials.toml
host_token any medium ~/.config/gh/hosts.yml
host_token any medium ~/.docker/config.json
host_token any medium ~/.gem/credentials
host_token any medium ~/.git-credentials
host_token any medium ~/.netrc
host_token any medium ~/.npmrc
host_token any medium ~/.pypirc
key_material any medium ~/.kube/config

# Kit SB_BROWSER_STORES (22).
[kit:SB_BROWSER_STORES]
browser_store linux relaxed ~/.config/BraveSoftware/Brave-Browser/
browser_store linux relaxed ~/.config/chromium/
browser_store linux relaxed ~/.config/google-chrome/
browser_store linux relaxed ~/.config/microsoft-edge/
browser_store linux relaxed ~/.config/opera/
browser_store linux relaxed ~/.config/vivaldi/
browser_store linux relaxed ~/.mozilla/firefox/
browser_store macos relaxed ~/Library/Application Support/Arc/
browser_store macos relaxed ~/Library/Application Support/BraveSoftware/Brave-Browser/
browser_store macos relaxed ~/Library/Application Support/Chromium/
browser_store macos relaxed ~/Library/Application Support/Firefox/
browser_store macos relaxed ~/Library/Application Support/Google/Chrome/
browser_store macos relaxed ~/Library/Application Support/Microsoft Edge/
browser_store macos relaxed ~/Library/Application Support/Vivaldi/
browser_store macos relaxed ~/Library/Application Support/com.operasoftware.Opera/
browser_store windows relaxed ~/AppData/Local/BraveSoftware/Brave-Browser/User Data/
browser_store windows relaxed ~/AppData/Local/Chromium/User Data/
browser_store windows relaxed ~/AppData/Local/Google/Chrome/User Data/
browser_store windows relaxed ~/AppData/Local/Microsoft/Edge/User Data/
browser_store windows relaxed ~/AppData/Local/Vivaldi/User Data/
browser_store windows relaxed ~/AppData/Roaming/Mozilla/Firefox/
browser_store windows relaxed ~/AppData/Roaming/Opera Software/

# safe-ai-skill classes: Solana keys and config tree, varlock and superstack stores, the
# $CLAUDE_CONFIG_DIR credentials file, wallet extension stores, and the readable exceptions
# (Solana CLI config; ssh config, known_hosts and public keys: decision Q1).
# Contract 1.2.0 (engine 1.2.0) added the dotenvx private-key files (`.env.keys`,
# `.env.keys.*`, `.env.*.keys`): key material, unlike the project .env they decrypt.
# Contract 1.1.0 added the cloud and infrastructure CLI token stores, which the kit's arrays
# never carried: gcloud, Azure CLI, doctl, Terraform Cloud, Helm repository credentials and
# the Vault token (host_token, sandbox-denied from Medium like the other host tokens).
[plugin]
!key_material any never ~/.config/solana/cli/config.yml
!key_material any never ~/.ssh/*.pub
!key_material any never ~/.ssh/config
!key_material any never ~/.ssh/known_hosts
host_token any medium ~/.azure/
host_token any medium ~/.config/doctl/
host_token any medium ~/.config/gcloud/
host_token any medium ~/.config/helm/
host_token any medium ~/.terraform.d/credentials.tfrc.json
host_token any medium ~/.vault-token
key_material any never **/*-keypair.json
key_material any never **/.env.*.keys
key_material any never **/.env.keys
key_material any never **/.env.keys.*
key_material any never ~/.config/solana/
key_material any never ~/.config/varlock/
key_material any never ~/.superstack/config.json
key_material any never ~/.varlock/
key_material any relaxed ${CLAUDE_CONFIG_DIR:-~/.claude}/.credentials.json
wallet_ext any relaxed **/IndexedDB/chrome-extension_*/
wallet_ext any relaxed **/Local Extension Settings/
