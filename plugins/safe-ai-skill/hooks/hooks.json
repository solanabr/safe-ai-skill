{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/safe-ai-skill gate-bash", "timeout": 20, "onFailure": "block" },
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/safe-ai-skill gate-bash-secrets", "timeout": 10, "onFailure": "continue" }
      ]},
      { "matcher": "Write|Edit|MultiEdit|NotebookEdit", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/safe-ai-skill gate-tamper", "timeout": 10, "onFailure": "continue" }
      ]},
      { "matcher": "Read|Grep|Glob", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/safe-ai-skill gate-read", "timeout": 10, "onFailure": "continue" }
      ]},
      { "matcher": "WebFetch", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/safe-ai-skill gate-webfetch", "timeout": 10, "onFailure": "continue" }
      ]},
      { "matcher": "mcp__.*", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/safe-ai-skill gate-mcp", "timeout": 15, "onFailure": "continue" }
      ]},
      { "matcher": "Skill", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/safe-ai-skill gate-skill", "timeout": 10, "onFailure": "block" }
      ]}
    ],
    "PostToolUse": [
      { "matcher": "Bash|Read|Grep|mcp__.*", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/safe-ai-skill redact", "timeout": 10, "onFailure": "continue" }
      ]},
      { "matcher": "Bash", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/safe-ai-skill pending-notice", "timeout": 10, "onFailure": "continue" }
      ]}
    ],
    "PostToolUseFailure": [
      { "matcher": "Bash|Read|Grep|mcp__.*", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/safe-ai-skill failure-notice", "timeout": 10, "onFailure": "continue" }
      ]}
    ],
    "UserPromptSubmit": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/safe-ai-skill prompt-guard", "timeout": 10, "onFailure": "continue" } ] },
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/safe-ai-skill gate-prompt-expansion", "timeout": 10, "onFailure": "continue" } ] }
    ],
    "UserPromptExpansion": [
      { "hooks": [ { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/safe-ai-skill gate-prompt-expansion", "timeout": 10, "onFailure": "continue" } ] }
    ],
    "SessionStart": [
      { "matcher": "startup|resume|clear|compact", "hooks": [
        { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/bin/safe-ai-skill verify session", "timeout": 60, "onFailure": "continue" }
      ]}
    ]
  }
}
