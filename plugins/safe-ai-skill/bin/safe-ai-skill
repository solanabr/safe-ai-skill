#!/bin/sh
# safe-ai-skill platform-dispatch shim.
#
# Runs the prebuilt engine for this platform (bin/safe-ai-skill-<plat>) as a child,
# forwarding all arguments and stdin, and maps the ways that can fail onto the hook
# contract (spec D6.1):
#   - Environment failure (no prebuilt for this platform, not an executable for this
#     machine, no sha256 tool to verify it, exit 126/127): fail open with a notice.
#     gate-bash keeps the Solana CLI surface at `ask` (a payload naming solana, spl-token,
#     anchor or keygen, or holding $'…'; any other Bash call gets no opinion), gate-skill asks
#     too, SessionStart reports the firewall INACTIVE, every other hook exits 0 with one
#     stderr line.
#   - Tamper (the prebuilt's sha256 differs from the constant stamped below at release):
#     the prebuilt never runs. gate-bash, gate-mcp and gate-skill exit 2, the other PreToolUse gates
#     ask, SessionStart reports the firewall TAMPERED, the remaining hooks exit 0 with a
#     stderr line, CLI subcommands exit 2.
#   - Engine crash (signal, or exit not in {0,2,3}): gate-bash, gate-mcp and gate-skill exit 2
#     (block); every other hook exits 0 with a stderr line, SessionStart with a notice.
#   - Codex hooks (`adapt codex <gate>`): Codex runs the call when a hook fails, so every
#     failure above, and an engine exit other than 0 or an answer other than nothing or one
#     deny line, prints Codex's deny JSON with exit 0. `adapt codex redact` (opt-in) blocks
#     the result the same way; `adapt codex session-start` reports like SessionStart. Any other
#     `adapt` entry denies too, and SAFE_AI_SKILL_DISABLE does not apply to `adapt`.
#   - opencode hooks (`adapt opencode <gate>`, run by the opencode plugin): the same deny JSON
#     on every failure, and the engine's answer passes only when it is nothing, one deny line
#     or (gate-read) one `updatedInput` line.
#   - SAFE_AI_SKILL_STRICT=1 makes every unusable case exit 2.
#   - SAFE_AI_SKILL_DISABLE=1 (exact) turns the hooks off, unless strict or the committed
#     project settings mention it (a repo can't disable the firewall); SessionStart
#     reports either way.
# Hooks capture the engine's output in memory, through pipes: no engine output ever
# touches a file, where another process of the same user could rewrite a verdict.
# CLI subcommands run the engine with live output and keep its exit status; an
# environment failure exits 1. Nothing outside this directory is ever executed (no cargo
# build, no $CLAUDE_PLUGIN_DATA binary).
#
# Verified-hash cache. Hashing the prebuilt costs more than the engine run it guards, so
# after a full sha256 match (and format check) the shim records the binary's fingerprint
# (device, inode, size, mtime, ctime, from `stat` at a fixed system path) beside the
# stamped hash in $CLAUDE_PLUGIN_DATA/shim-verified-<plat> (written to a temp file and
# moved in place, mode 0600). A later run skips the hash only when that file is a regular
# file (not a symlink) of mode 0600 owned by the binary's owner, and its line equals this
# shim's stamped hash plus the binary's current fingerprint. Anything else (no cache, a
# mismatch, stat failing or printing something unexpected) means a full sha256 check, so
# only a pass is ever cached and a failed probe never outlives the run that saw it.
# Why this is safe: ctime can't be set by a user process, so modifying or replacing the
# binary (rename, copy, touch -m included) changes the fingerprint and forces a rehash; a
# binary changed within its ctime's second is never cached (its ctime must predate the
# check); and an attacker able to rewrite both the binary and the cache can already
# rewrite this shim. Off on Windows, where a user process can set ctime, and when
# CLAUDE_PLUGIN_DATA is unset, relative or not a writable dir.
# SAFE_AI_SKILL_SHIM_CACHE=0 turns the cache off (every hook call hashes the binary,
# which is slower); it is honoured from any source, since it only makes the shim stricter.

set -fu

# sha256 of each prebuilt, stamped by scripts/stamp-shim.sh when release.yml vendors the
# binaries. Empty: this release ships no prebuilt for that platform.
sha256_darwin_arm64=c1aa1cf6a7c8edccf0a694a58e113e82147583e6dd3262c94734cd126353d6b2
sha256_darwin_x64=f024cbed11af8e431b514b575ba68abc0de0a624fea9d3559306e852fed0326d
sha256_linux_x64=0841177e292792483d1de26d8fbd94136f8cd5f6b8ff9d7c8245ccc9bf89fec4
sha256_linux_arm64=3ca82dd64be0ae18898230a8d938b9c3f6e20f1adc31f80aa0218e8534c5890e
sha256_windows_x64=

case $0 in
  */*) self_dir=${0%/*} ;;
  *) self_dir=. ;;
esac

# Which hook contract applies, from the subcommand the hook runs.
sub=${1:-}
case $sub in
  gate-bash) kind=solana ;;
  gate-mcp) kind=mcp ;;
  # A fail-open Skill gate would let a blocked pack's `!cmd` run (spec D6.2 as amended).
  gate-skill) kind=skill ;;
  # Hooks on events other than PreToolUse, where `ask` means nothing.
  gate-prompt-expansion | redact | failure-notice | prompt-guard | pending-notice) kind=other ;;
  gate-*) kind=broad ;;
  verify) if [ "${2:-}" = session ]; then kind=session sub='verify session'; else kind=cli; fi ;;
  # Hooks of other clients, by client and entry.
  adapt)
    case ${2:-}/${3:-} in
      codex/session-start) kind=session sub='adapt codex session-start' ;;
      codex/redact) kind=codex_post ;;
      opencode/*) kind=opencode ;;
      # Only another client's hook runs `adapt`: an entry nobody recognises (a typo in the
      # hook config) blocks rather than letting Codex run the call.
      *) kind=codex ;;
    esac
    ;;
  *) kind=cli ;;
esac

strict=
if [ "${SAFE_AI_SKILL_STRICT:-}" = 1 ]; then strict=1; fi

# What an engine that cannot run means for the session, as SessionStart reports it.
inactive_effect='Solana CLI commands ask for manual review; the other gates are off.'
tampered_effect='Solana CLI and MCP calls are blocked, other tool calls ask for review. Reinstall the plugin.'
crashed_effect='A crashing engine blocks Solana CLI and MCP calls and skips the other gates.'
case $sub in
  'adapt codex session-start')
    inactive_effect='Every tool call the Codex hooks check is blocked until this is fixed.'
    tampered_effect='Every tool call the Codex hooks check is blocked. Reinstall safe-ai-skill.'
    crashed_effect='A crashing engine blocks every tool call the Codex hooks check.'
    ;;
esac

# Static PreToolUse `ask` for the Solana surface while the engine can't judge it.
# Arguments to these two must be JSON-safe.
ask_json() {
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"ask","permissionDecisionReason":"%s"}}\n' "$1"
}

# Codex answers (exit 0): a PreToolUse deny, a PostToolUse block. Arguments must be JSON-safe.
codex_deny() {
  printf '{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny","permissionDecisionReason":"%s"}}\n' "$1"
  exit 0
}
codex_block() {
  printf '{"decision":"block","reason":"%s"}\n' "$1"
  exit 0
}
# codex_fail <why>: the engine gave Codex no usable answer, so block (codex kinds only).
codex_fail() {
  case $kind in
    codex) codex_deny "safe-ai-skill: $1. Codex would run this call unchecked, so it is blocked; review it and run it yourself." ;;
    opencode) codex_deny "safe-ai-skill: $1. The call is blocked; review it and run it yourself." ;;
    codex_post) codex_block "safe-ai-skill: $1. This result was not scanned for secrets, so it is withheld." ;;
  esac
}

# SessionStart notice for the user (systemMessage) and the model (additionalContext).
session_notice() {
  printf '{"systemMessage":"%s","hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}\n' "$1" "$1"
}

# Whether the committed project settings may set SAFE_AI_SKILL_DISABLE. Any SAFE_AI_SKILL
# text counts, and so does any \u escape (JSON can spell the key without its plain text),
# as does a file grep can't read. A text match only stops the obvious cases: a repo's
# settings env is trusted-code-equivalent.
disable_set_by_repo() {
  settings=${CLAUDE_PROJECT_DIR:-.}/.claude/settings.json
  [ -e "$settings" ] || return 1
  grep -qF -e SAFE_AI_SKILL -e '\u' "$settings" 2>/dev/null
  case $? in
    1) return 1 ;;
  esac
}

repo_disable=
repo_note='SAFE_AI_SKILL_DISABLE set by project settings — ignored.'
# Another client's hooks (`adapt`) ignore SAFE_AI_SKILL_DISABLE: its environment comes from the
# login shell, whose startup files an agent can write.
adapt_hook=
if [ "$sub" = adapt ] || [ "$sub" = 'adapt codex session-start' ]; then adapt_hook=1; fi
if [ "${SAFE_AI_SKILL_DISABLE:-}" = 1 ] && [ "$kind" != cli ] && [ -z "$adapt_hook" ]; then
  if disable_set_by_repo; then
    repo_disable=1
  elif [ -z "$strict" ]; then
    if [ "$kind" = session ]; then
      session_notice 'safe-ai-skill firewall INACTIVE: disabled by SAFE_AI_SKILL_DISABLE=1, no gate is running.'
    fi
    exit 0
  fi
fi

os=$(uname -s 2>/dev/null) || os=
arch=$(uname -m 2>/dev/null) || arch=
ext=
case $os in
  Darwin) family=darwin ;;
  Linux) family=linux ;;
  MINGW* | MSYS* | CYGWIN*) family=windows ext=.exe ;;
  *) family=unsupported ;;
esac
case $family/$arch in
  darwin/arm64 | darwin/aarch64) plat=darwin-arm64 want_sha=$sha256_darwin_arm64 ;;
  darwin/x86_64 | darwin/amd64) plat=darwin-x64 want_sha=$sha256_darwin_x64 ;;
  linux/x86_64 | linux/amd64) plat=linux-x64 want_sha=$sha256_linux_x64 ;;
  linux/aarch64 | linux/arm64) plat=linux-arm64 want_sha=$sha256_linux_arm64 ;;
  # Windows on ARM runs the x64 build under emulation.
  windows/x86_64 | windows/amd64 | windows/aarch64 | windows/arm64)
    plat=windows-x64 want_sha=$sha256_windows_x64
    ;;
  *) plat= ;;
esac

# uname output ends up in JSON, so anything outside this set makes the label "unknown".
safe=0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz._-
label=${plat:-${os:-unknown}/${arch:-unknown}}
case $label in
  *[!/$safe]*) label=unknown ;;
esac

# env_failure <reason> [<detail>]: the engine can't run here, so fail open with a notice.
# <reason> is a fixed phrase (it goes into JSON). <detail> goes to stderr, which Claude Code
# keeps in its debug log for an exit-0 hook, and, reduced to a JSON-safe character set, into
# the SessionStart systemMessage: the one place the user sees why.
env_failure() {
  printf 'safe-ai-skill: firewall inactive on %s: %s%s\n' "$label" "$1" "${2:+: $2}" >&2
  why=
  if [ -n "${2:-}" ]; then
    why=$(printf '%s' "$2" | tr -cd 'A-Za-z0-9 ._:/()=,+-' 2>/dev/null | cut -c1-200 2>/dev/null) || why=
  fi
  codex_fail "engine inactive on $label: $1"
  if [ -n "$strict" ]; then exit 2; fi
  case $kind in
    solana)
      # gate-bash runs for every Bash call: keep the ask to the Solana surface. A payload
      # grep can't read (exit 2, no grep) still asks.
      grep -qiE "solana|spl-token|anchor|keygen|[$]'" 2>/dev/null
      if [ $? -ne 1 ]; then
        ask_json "safe-ai-skill inactive on $label: $1; review this command manually"
      fi
      ;;
    skill) ask_json "safe-ai-skill inactive on $label: $1; review this skill call manually" ;;
    session) session_notice "safe-ai-skill firewall INACTIVE on $label: $1${why:+ ($why)}. $inactive_effect${repo_disable:+ $repo_note}" ;;
    cli) exit 1 ;;
  esac
  exit 0
}

# tampered: the prebuilt fails its sha256 check, so it never runs.
tampered() {
  printf 'safe-ai-skill: %s fails its sha256 check (tampered, or not the binary this release shipped); not running it\n' "${bin##*/}" >&2
  codex_fail "the engine binary on $label fails its sha256 check (tampered?) and was not run"
  case $kind in
    solana | mcp | skill | cli) exit 2 ;;
  esac
  if [ -n "$strict" ]; then exit 2; fi
  case $kind in
    broad) ask_json "safe-ai-skill engine binary on $label fails its sha256 check (tampered?); review this call manually" ;;
    session) session_notice "safe-ai-skill firewall TAMPERED on $label: the engine binary fails its sha256 check and was not run. $tampered_effect${repo_disable:+ $repo_note}" ;;
  esac
  exit 0
}

# sha256_ok <file>: whether <file> hashes to $want_sha. Returns 1 on a mismatch; an
# environment failure when no sha256 tool exists or the tool fails. The tool is taken from
# fixed system paths first, so a repo-set PATH can't stand in for it there; PATH is the
# fallback (NixOS and the like). A `.sha-tools-from-path` file beside the shim (the test
# harness's own plugin layout) skips the fixed paths; writing there is as good as rewriting
# the shim, so it grants nothing new.
sha256_ok() {
  sha_tool=
  if [ ! -e "$self_dir/.sha-tools-from-path" ]; then
    for t in /usr/bin/sha256sum /bin/sha256sum /sbin/sha256sum /usr/bin/shasum; do
      if [ -z "$sha_tool" ] && [ -f "$t" ] && [ -x "$t" ]; then sha_tool=$t; fi
    done
  fi
  if [ -z "$sha_tool" ]; then
    if command -v sha256sum >/dev/null 2>&1; then
      sha_tool=sha256sum
    elif command -v shasum >/dev/null 2>&1; then
      sha_tool=shasum
    else
      env_failure 'no sha256sum or shasum to verify the engine binary'
    fi
  fi
  case $sha_tool in
    *shasum) got=$("$sha_tool" -a 256 <"$1" 2>/dev/null) || env_failure 'sha256 check failed to run' ;;
    *) got=$("$sha_tool" <"$1" 2>/dev/null) || env_failure 'sha256 check failed to run' ;;
  esac
  got=${got%%[!0-9a-f]*}
  if [ "${#got}" -ne 64 ]; then env_failure 'sha256 check failed to run'; fi
  [ "$got" = "$want_sha" ]
}

# crashed <status>: the engine started and died, so block where a missed verdict is
# dangerous and continue elsewhere.
crashed() {
  if [ "$1" -gt 128 ]; then how="signal $(($1 - 128))"; else how="exit $1"; fi
  codex_fail "the engine failed ($how)"
  case $kind in
    solana | mcp | skill)
      printf 'safe-ai-skill: engine crashed (%s); %s blocked this call\n' "$how" "$sub" >&2
      exit 2
      ;;
  esac
  printf 'safe-ai-skill: engine crashed (%s); %s skipped\n' "$how" "$sub" >&2
  if [ -n "$strict" ]; then exit 2; fi
  if [ "$kind" = session ]; then
    session_notice "safe-ai-skill firewall INACTIVE on $label: the engine crashed ($how) in the session check. $crashed_effect${repo_disable:+ $repo_note}"
  fi
  exit 0
}

# exec_format_ok <file>: whether the kernel can exec <file> on this machine. Anything
# else fails execve with ENOEXEC, and POSIX shells then run the file as a shell script.
# A Linux ELF must be 64-bit (EI_CLASS 2) for this machine (e_machine 0x3e or 0xb7).
exec_format_ok() {
  command -v od >/dev/null 2>&1 || return 0
  magic=$(od -A n -t x1 -N 20 "$1" 2>/dev/null) || return 0
  IFS=' 	
'
  # shellcheck disable=SC2086 # split od's output into one argument per byte
  set -- $magic
  case ${1:-}${2:-} in
    2321) return 0 ;; # "#!"
  esac
  case $plat/${1:-}${2:-}${3:-}${4:-}/${5:-}/${19:-}${20:-} in
    linux-x64/7f454c46/02/3e00 | linux-arm64/7f454c46/02/b700) return 0 ;;
  esac
  case $family/${1:-}${2:-}${3:-}${4:-} in
    darwin/cffaedfe | darwin/cefaedfe | darwin/cafebabe | darwin/cafebabf) return 0 ;;
    windows/4d5a*) return 0 ;;
  esac
  return 1
}

# fixed_tool <name>: sets tool to <name> from /usr/bin or /bin (from PATH under the test
# seam, as for the sha256 tool), or to empty. No subshell: it runs on every hook call.
fixed_tool() {
  tool=
  if [ -e "$self_dir/.sha-tools-from-path" ]; then
    tool=$(command -v "$1" 2>/dev/null) || tool=
    return 0
  fi
  for d in /usr/bin /bin; do
    if [ -z "$tool" ] && [ -f "$d/$1" ] && [ -x "$d/$1" ]; then tool=$d/$1; fi
  done
}

# file_stats <file>...: one line per file, "uid perms dev ino size mtime ctime <times>",
# from BSD/macOS `stat -f` or GNU/busybox `stat -c`, the host's flavour tried first. Each
# flavour is a separate capture, so a failed one leaves nothing behind.
file_stats() {
  if [ "$family" = darwin ]; then
    "$stat_tool" -f '%u %Lp %d %i %z %m %c %Fm|%Fc' "$@" 2>/dev/null ||
      "$stat_tool" -c '%u %a %d %i %s %Y %Z %y|%z' "$@" 2>/dev/null
  else
    "$stat_tool" -c '%u %a %d %i %s %Y %Z %y|%z' "$@" 2>/dev/null ||
      "$stat_tool" -f '%u %Lp %d %i %z %m %c %Fm|%Fc' "$@" 2>/dev/null
  fi
}

# stat_split <line>: sets s_uid, s_perm, s_ctime (whole seconds) and s_fp (everything but
# uid and perms) from one file_stats line; fails on any other shape.
stat_chars='0123456789 .:+|-'
stat_split() {
  case $1 in
    '' | *[!$stat_chars]*) return 1 ;;
  esac
  IFS=' '
  # shellcheck disable=SC2086 # split the line into fields; globbing is off (set -f)
  set -- $1
  IFS=' 	
'
  [ "$#" -ge 8 ] || return 1
  s_uid=$1 s_perm=$2 s_ctime=$7
  case $s_uid$s_ctime in
    '' | *[!0-9]*) return 1 ;;
  esac
  shift 2
  s_fp=$*
}

# cache_hit: whether the cache vouches for $bin (see the header). Any doubt is a miss.
cache_hit() {
  [ -n "$cache" ] && [ ! -L "$bin" ] && [ -f "$cache" ] && [ ! -L "$cache" ] || return 1
  stats=$(file_stats "$bin" "$cache") || return 1
  case $stats in
    *"$cache_nl"*"$cache_nl"*) return 1 ;;
    *"$cache_nl"*) ;;
    *) return 1 ;;
  esac
  stat_split "${stats#*"$cache_nl"}" || return 1
  c_uid=$s_uid c_perm=$s_perm
  stat_split "${stats%%"$cache_nl"*}" || return 1
  [ "$c_perm" = 600 ] && [ "$c_uid" = "$s_uid" ] || return 1
  IFS= read -r have <"$cache" 2>/dev/null || return 1
  [ "$have" = "v1 $plat $want_sha $s_fp" ]
}

# cache_begin: on a miss, the time and the fingerprint before hashing (pre_fp empty when
# the cache can't be written). cache_store: after the checks pass, record the fingerprint
# if the binary didn't change meanwhile and its ctime predates the check.
cache_begin() {
  pre_fp=
  [ -n "$cache" ] && [ ! -L "$bin" ] && [ ! -L "$cache" ] || return 0
  [ -d "$CLAUDE_PLUGIN_DATA" ] && [ -w "$CLAUDE_PLUGIN_DATA" ] || return 0
  fixed_tool date
  [ -n "$tool" ] || return 0
  now=$("$tool" +%s 2>/dev/null) || return 0
  case $now in
    '' | *[!0-9]*) return 0 ;;
  esac
  stats=$(file_stats "$bin") || return 0
  stat_split "$stats" || return 0
  [ "$s_ctime" -lt "$now" ] || return 0
  pre_fp=$s_fp
}
cache_store() {
  [ -n "$pre_fp" ] || return 0
  stats=$(file_stats "$bin") || return 0
  stat_split "$stats" || return 0
  [ "$s_fp" = "$pre_fp" ] || return 0
  if [ -e "$cache" ] || [ -L "$cache" ]; then
    [ -f "$cache" ] && [ ! -L "$cache" ] || return 0
  fi
  tmp=$CLAUDE_PLUGIN_DATA/.shim-verified-$plat.$$
  (
    umask 077
    set -C
    printf 'v1 %s %s %s\n' "$plat" "$want_sha" "$pre_fp" >"$tmp"
  ) 2>/dev/null || return 0
  mv -f "$tmp" "$cache" 2>/dev/null || rm -f "$tmp" 2>/dev/null
}

if [ -z "$plat" ]; then env_failure 'unsupported platform'; fi
bin=$self_dir/safe-ai-skill-$plat$ext
if [ ! -f "$bin" ]; then env_failure 'no engine binary for this platform'; fi
if [ ! -x "$bin" ]; then env_failure 'engine binary is not executable'; fi

cache=
cache_nl='
'
if [ "${SAFE_AI_SKILL_SHIM_CACHE:-}" != 0 ] && [ "$family" != windows ] &&
  [ "${#want_sha}" -eq 64 ]; then
  case ${CLAUDE_PLUGIN_DATA:-} in
    /*) cache=$CLAUDE_PLUGIN_DATA/shim-verified-$plat ;;
  esac
fi
stat_tool=
if [ -n "$cache" ]; then fixed_tool stat && stat_tool=$tool; fi
if [ -z "$stat_tool" ]; then cache=; fi

if ! cache_hit; then
  cache_begin
  if ! sha256_ok "$bin"; then tampered; fi
  if ! exec_format_ok "$bin"; then env_failure "engine binary is not an executable for $label"; fi
  cache_store
fi

if [ "$kind" = cli ]; then
  "$bin" "$@"
  status=$?
  case $status in
    126 | 127) env_failure "engine could not start (exit $status)" ;;
  esac
  exit "$status"
fi

nl='
'

# with_repo_note <engine stdout>: SessionStart reports an ignored repo-set DISABLE: prefixed
# to the engine's systemMessage, added as one when it has none, or on its own when the
# engine said nothing.
with_repo_note() {
  key='"systemMessage":"'
  case $1 in
    '' | '{}') session_notice "safe-ai-skill: $repo_note" ;;
    *"$key"*) printf '%s%ssafe-ai-skill: %s\\n%s' "${1%%"$key"*}" "$key" "$repo_note" "${1#*"$key"}" ;;
    '{"'*) printf '{"systemMessage":"safe-ai-skill: %s",%s' "$repo_note" "${1#?}" ;;
    *) printf '%s' "$1" ;;
  esac
}
note_repo=
if [ -n "$repo_disable" ] && [ "$kind" = session ]; then note_repo=1; fi

# run_engine <args...>: run the engine. Its stdout goes to ours, followed by "." (so
# trailing newlines survive capture), or on 126/127 by a newline and the first line of
# the start error. Its stderr is held back until it exits, so a failed start adds no
# lines of its own.
run_engine() {
  { err=$("$bin" "$@" 2>&1 1>&3 3>&-); s=$?; } 3>&1
  case $s in
    126 | 127) printf '\n%s' "${err%%"$nl"*}" ;;
    *)
      if [ -n "$err" ]; then printf '%s\n' "$err" >&2; fi
      printf .
      ;;
  esac
  return "$s"
}

status=0
out=$(run_engine "$@") || status=$?

# Codex: only nothing, or one line of the expected answer, reaches Codex; anything else (a
# second line, which Codex could not parse, included) blocks.
# shellcheck disable=SC2016 # backticks are literal text in two of these messages
case $kind/$status in
  codex/0 | codex_post/0 | opencode/0)
    out=${out%.}
    out=${out%"$nl"}
    case $kind/$out in
      */) exit 0 ;;
      */*"$nl"*) codex_fail 'the engine gave an answer the client cannot use' ;;
      'codex/{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny",'*'}}' | \
        'opencode/{"hookSpecificOutput":{"hookEventName":"PreToolUse","permissionDecision":"deny",'*'}}' | \
        'opencode/{"hookSpecificOutput":{"hookEventName":"PreToolUse","updatedInput":'*'}}' | \
        'codex_post/{"decision":"block","reason":"'*'"}')
        printf '%s\n' "$out"
        exit 0
        ;;
    esac
    codex_fail 'the engine gave an answer the client cannot use'
    ;;
  codex/126 | codex/127 | codex_post/126 | codex_post/127 | opencode/126 | opencode/127) ;;
  codex/3 | codex_post/3) codex_fail 'this hook entry is misconfigured (see `safe-ai-skill adapt codex` usage); fix the hooks.json command' ;;
  opencode/3) codex_fail 'this adapt entry is misconfigured (see `safe-ai-skill adapt opencode` usage); reinstall the opencode plugin' ;;
  codex/* | codex_post/* | opencode/*) crashed "$status" ;;
esac

case $status in
  0 | 2 | 3)
    out=${out%.}
    # SessionStart reports an ignored repo-set DISABLE (with_repo_note). On exit 2/3 the
    # engine's verdict stands and stderr names it.
    if [ -n "$note_repo" ] && [ "$status" != 0 ]; then
      printf 'safe-ai-skill: %s\n' "$repo_note" >&2
      printf '%s' "$out"
    elif [ -n "$note_repo" ]; then
      with_repo_note "$out"
    else
      printf '%s' "$out"
    fi
    exit "$status"
    ;;
  126 | 127) env_failure "engine could not start (exit $status)" "${out##*"$nl"}" ;;
esac
crashed "$status"
